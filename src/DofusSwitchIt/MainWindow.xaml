<Window x:Class="DofusSwitchIt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DofusSwitch-It" Height="380" Width="420">
    <DockPanel Margin="10">
        <TextBlock DockPanel.Dock="Top" Margin="0,0,0,6" TextWrapping="Wrap"
                   Text="Ventanas de Dofus detectadas (F2 = anterior, F3 = siguiente):" />
        <TextBlock DockPanel.Dock="Bottom" Margin="0,6,0,0" x:Name="StatusText"
                   Text="Iniciando…" TextWrapping="Wrap" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
            <Button x:Name="PreviousButton" Content="◀ Anterior (F2)" Width="120" Margin="0,0,6,0" Click="PreviousButton_Click" />
            <Button x:Name="NextButton" Content="Siguiente (F3) ▶" Width="120" Margin="0,0,6,0" Click="NextButton_Click" />
            <Button x:Name="RefreshButton" Content="Refrescar" Width="90" Click="RefreshButton_Click" />
        </StackPanel>
        <ListBox x:Name="WindowList" MouseDoubleClick="WindowList_MouseDoubleClick" />
    </DockPanel>
</Window>
