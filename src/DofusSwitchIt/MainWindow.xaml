<Window x:Class="DofusSwitchIt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DofusSwitch-It" Height="420" Width="230" MinWidth="180" MinHeight="200"
        Topmost="True">
    <DockPanel Margin="8">
        <TextBlock DockPanel.Dock="Top" FontSize="11" HorizontalAlignment="Center" Opacity="0.75"
                   Margin="0,0,0,6" Text="F2 ◀ Anterior · Siguiente ▶ F3" />
        <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
            <Button DockPanel.Dock="Right" x:Name="RefreshButton" Content="⟳" Width="30" FontSize="14"
                    ToolTip="Refrescar lista" Click="RefreshButton_Click" />
            <TextBlock x:Name="StatusText" FontSize="11" Opacity="0.75" TextWrapping="Wrap"
                       VerticalAlignment="Center" Text="Iniciando…" />
        </DockPanel>
        <ListBox x:Name="WindowList" AllowDrop="True" ToolTip="Arrastra para ordenar (orden de turnos). Doble clic para enfocar."
                 PreviewMouseLeftButtonDown="WindowList_PreviewMouseLeftButtonDown"
                 MouseMove="WindowList_MouseMove"
                 DragOver="WindowList_DragOver"
                 Drop="WindowList_Drop"
                 MouseDoubleClick="WindowList_MouseDoubleClick" />
    </DockPanel>
</Window>
