<Window x:Class="DofusSwitchIt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DS-I" Height="210" Width="172"
        ResizeMode="NoResize" Topmost="True" WindowStartupLocation="Manual"
        Icon="Logo/DofusSwitch-It.ico"
        Background="#1E1E1E" Foreground="#D8D8D8">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#252526" />
        <SolidColorBrush x:Key="Border" Color="#3A3A3A" />
        <SolidColorBrush x:Key="Fg" Color="#D8D8D8" />
        <SolidColorBrush x:Key="Dim" Color="#9A9A9A" />
        <SolidColorBrush x:Key="Sel" Color="#37373D" />
        <SolidColorBrush x:Key="Hover" Color="#2D2D30" />
        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource Hover}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource Sel}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Panel}" />
            <Setter Property="Foreground" Value="{StaticResource Fg}" />
            <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>
    <DockPanel Margin="8">
        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
            <TextBlock FontSize="12" Foreground="{StaticResource Dim}"
                       HorizontalAlignment="Left" Text="◀ F2" />
            <TextBlock FontSize="12" Foreground="{StaticResource Dim}"
                       HorizontalAlignment="Right" Text="F3 ▶" />
        </Grid>
        <Grid DockPanel.Dock="Bottom" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" x:Name="StatusText" FontSize="12" Foreground="{StaticResource Dim}"
                       VerticalAlignment="Center" Text="…" />
            <Button Grid.Column="1" x:Name="HelpButton" Content="?" Width="26" FontSize="13"
                    HorizontalAlignment="Center" ToolTip="Ayuda" Click="HelpButton_Click" />
            <Button Grid.Column="2" x:Name="RefreshButton" Content="⟳" Width="28" FontSize="14"
                    ToolTip="Refrescar" Click="RefreshButton_Click" />
        </Grid>
        <ListBox x:Name="WindowList" AllowDrop="True" FontSize="13"
                 Background="{StaticResource Panel}" Foreground="{StaticResource Fg}"
                 BorderBrush="{StaticResource Border}" BorderThickness="1"
                 ToolTip="Arrastra para ordenar. Doble clic para enfocar."
                 PreviewMouseLeftButtonDown="WindowList_PreviewMouseLeftButtonDown"
                 MouseMove="WindowList_MouseMove"
                 DragOver="WindowList_DragOver"
                 Drop="WindowList_Drop"
                 MouseDoubleClick="WindowList_MouseDoubleClick" />
    </DockPanel>
</Window>
